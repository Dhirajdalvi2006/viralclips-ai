# VIRALCLIPS AI -- example configuration
#
# Copy this file to `.env` in the project root and fill in your own
# values, OR put the credentials in the file that lives outside the
# project:
#
#     %LOCALAPPDATA%\ViralClipsAI\credentials.env
#
# The external file is preferred: it never travels with a copy of the
# project and is never committed.
#
# Lookup priority is: process environment -> credential file -> this
# project-level .env. A shell session always wins.
#
# THIS FILE MUST NEVER CONTAIN A REAL KEY.

# --- AI provider ---------------------------------------------------------
# The provider the application uses: groq, openrouter or none.
VIRALCLIPS_AI_PROVIDER=groq

# The model that provider serves. groq serves openai/gpt-oss-120b.
VIRALCLIPS_AI_MODEL=openai/gpt-oss-120b

# An optional second provider, tried when the primary fails.
# VIRALCLIPS_AI_FALLBACK=openrouter

# --- Credentials ----------------------------------------------------------
# Put the real values here. Leave them blank in this file.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Publishing (optional) ------------------------------------------------
# Both are needed before a platform reports as connected. The redirect URI
# must be http://127.0.0.1:8799/api/accounts/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Instagram's Graph API cannot fetch a file from a loopback address, so a
# publicly reachable HTTPS host is required for the media file.
# VIRALCLIPS_PUBLIC_MEDIA_URL=

# --- Local paths ----------------------------------------------------------
# The credential file. Defaults to %LOCALAPPDATA%\ViralClipsAI\credentials.env
# VIRALCLIPS_CREDENTIALS_FILE=

# The API port. Defaults to 8799.
# VIRALCLIPS_API_PORT=8799

# --- Optional tuning ------------------------------------------------------
# VIRALCLIPS_WHISPER_MODEL=tiny
# VIRALCLIPS_LLM_MAX_TOKENS=2048
